  end

  provider["Declared model destination"]

  controller --> vm
  candidate --> workspace
  candidate --> decoy
  candidate --> mocks
  candidate --> agenthome
  candidate -->|"host-only network; one allowed service"| gateway
  gateway --> provider
  vm -. "serial, virtual-switch, and disk-diff evidence" .-> observer
  source -. "no mount, clipboard, or shared folder" .- vm
