flowchart LR
  subgraph host["Controller host"]
    controller["External run controller"]
    observer["Candidate-inaccessible evidence store"]
    gateway["Allowlisted model gateway<br/>provider credential stays here"]
    source["Catalog and real host data<br/>never mounted into guest"]
  end

  subgraph vm["Fresh single-use VM"]
