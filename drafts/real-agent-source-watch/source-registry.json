    },
    "quarterly": {
      "automated": false,
      "purpose": "Review security sources, source ownership, lifecycle coverage, normalization behavior, and scheduling safety.",
      "allowedOutput": "A maintenance retrospective and separately authorized backward-compatible watcher changes.",
      "humanBoundary": "Policy, schema, catalog lifecycle, scoring, publication, outreach, and product testing remain outside the watcher."
    }
