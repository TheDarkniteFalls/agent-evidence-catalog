{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evidence-catalog.example/schemas/agent-record-v1.schema.json",
  "title": "Agent Evidence Catalog profile v1",
  "description": "One exact agent version, its human-readable permission declaration, and version-specific evidence receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "name",
    "category",
    "summary",
    "publisher",
    "version",
    "delivery",
    "interoperability",
    "permissionDeclaration",
    "evidenceReceipts",
    "verificationEvidence",
    "limitations",
    "selectionCue"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]+-[0-9]+-[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "publisher": { "$ref": "#/$defs/publisher" },
    "version": { "$ref": "#/$defs/version" },
    "delivery": { "$ref": "#/$defs/delivery" },
    "interoperability": { "$ref": "#/$defs/interoperability" },
    "permissionDeclaration": { "$ref": "#/$defs/permissionDeclaration" },
    "evidenceReceipts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/receiptWrapper" }
    },
    "verificationEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/verificationEvidence" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "selectionCue": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "status": {
      "enum": ["verified", "observed", "declared", "stale", "unknown", "not-applicable"]
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimPath", "uri", "sha256", "verifiedAt", "verifier", "method"],
      "properties": {
        "claimPath": { "type": "string", "pattern": "^/", "minLength": 2 },
        "uri": { "type": "string", "pattern": "^https://", "format": "uri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "verifier": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ownership"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method"],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "method": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sha256"],
      "properties": {
        "kind": { "enum": ["oci", "source-archive", "hosted-release"] },
        "uri": { "type": "string", "format": "uri" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "artifact"],
      "properties": {
        "number": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "sourceRevision": { "type": "string", "minLength": 7 },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sourceAvailability"],
      "properties": {
        "mode": { "enum": ["local", "hosted", "hybrid", "unknown"] },
        "sourceAvailability": { "enum": ["public", "private", "unavailable", "unknown"] }
      }
    },
    "namedStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "a2a": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["protocolVersion", "cardUri", "cardSha256", "status"],
      "properties": {
        "protocolVersion": { "type": "string", "minLength": 1 },
        "cardUri": { "type": "string", "format": "uri" },
        "cardSha256": { "$ref": "#/$defs/sha256" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "oci": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["image", "digest", "provenanceStatus", "sbomStatus"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "provenanceStatus": { "$ref": "#/$defs/status" },
        "sbomStatus": { "$ref": "#/$defs/status" }
      }
    },
    "interoperability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a2a", "agentSkills", "mcpServers", "oci"],
      "properties": {
        "a2a": { "$ref": "#/$defs/a2a" },
        "agentSkills": { "type": "array", "items": { "$ref": "#/$defs/namedStatus" } },
        "mcpServers": { "type": "array", "items": { "$ref": "#/$defs/namedStatus" } },
        "oci": { "$ref": "#/$defs/oci" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "description", "confirmation", "reversibility", "status"],
      "properties": {
        "scope": { "enum": ["none", "selected-only", "allowlisted", "broad", "unknown"] },
        "description": { "type": "string", "minLength": 1 },
        "confirmation": { "enum": ["none", "exact", "before-external-action", "always-forbidden", "not-applicable", "unknown"] },
        "reversibility": { "enum": ["reversible", "difficult", "not-applicable", "unknown"] },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "permissionDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuedAt",
        "digest",
        "signatureStatus",
        "mode",
        "actions",
        "files",
        "processes",
        "network",
        "credentials",
        "dataHandling",
        "delegation",
        "gaps",
        "invalidatedBy",
        "reviewedAt"
      ],
      "properties": {
        "issuedAt": { "type": "string", "format": "date-time" },
        "digest": { "$ref": "#/$defs/sha256" },
        "signatureStatus": { "$ref": "#/$defs/status" },
        "mode": { "enum": ["local", "hosted", "hybrid", "unknown"] },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "draft", "change", "communicate", "spend"],
          "properties": {
            "read": { "$ref": "#/$defs/action" },
            "draft": { "$ref": "#/$defs/action" },
            "change": { "$ref": "#/$defs/action" },
            "communicate": { "$ref": "#/$defs/action" },
            "spend": { "$ref": "#/$defs/action" }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write", "forbidden", "enforcementStatus"],
          "properties": {
            "read": { "type": "string", "minLength": 1 },
            "write": { "type": "string", "minLength": 1 },
            "forbidden": { "type": "string", "minLength": 1 },
            "enforcementStatus": { "$ref": "#/$defs/status" }
          }
        },
        "processes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "generatedCode", "boundary", "enforcementStatus"],
          "properties": {
            "scope": { "enum": ["none", "allowlisted", "broad", "unknown"] },
            "generatedCode": { "type": ["boolean", "null"] },
            "boundary": { "type": "string", "minLength": 1 },
            "enforcementStatus": { "$ref": "#/$defs/status" }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "destinations", "dataSent", "enforcementStatus"],
          "properties": {
            "scope": { "enum": ["none", "allowlisted", "broad", "unknown"] },
            "destinations": { "type": "string", "minLength": 1 },
            "dataSent": { "type": "string", "minLength": 1 },
            "enforcementStatus": { "$ref": "#/$defs/status" }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "scopes", "storage", "lifetime", "exportRisk"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "scopes": { "type": "string", "minLength": 1 },
            "storage": { "type": "string", "minLength": 1 },
            "lifetime": { "type": "string", "minLength": 1 },
            "exportRisk": { "enum": ["no", "possible", "unknown"] }
          }
        },
        "dataHandling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["categories", "leavesEnvironment", "retention", "deletionRoute", "trainingUse"],
          "properties": {
            "categories": { "type": "string", "minLength": 1 },
            "leavesEnvironment": { "type": "string", "minLength": 1 },
            "retention": { "type": "string", "minLength": 1 },
            "deletionRoute": { "type": "string", "minLength": 1 },
            "trainingUse": { "type": "string", "minLength": 1 }
          }
        },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mayCallAgents", "policy", "downstreamPinned"],
          "properties": {
            "mayCallAgents": { "type": ["boolean", "null"] },
            "policy": { "type": "string", "minLength": 1 },
            "downstreamPinned": { "type": ["boolean", "null"] }
          }
        },
        "gaps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "invalidatedBy": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reviewedAt": { "type": "string", "format": "date" }
      }
    },
    "receiptWrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayStatus", "statement"],
      "properties": {
        "displayStatus": { "enum": ["observed", "stale"] },
        "statement": {
          "allOf": [
            {
              "type": "object",
              "required": ["_type", "subject", "predicateType", "predicate"],
              "properties": {
                "_type": { "const": "https://in-toto.io/Statement/v1" },
                "subject": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "digest"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1 },
                      "digest": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["sha256"],
                        "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
                      }
                    }
                  }
                },
                "predicateType": { "const": "https://agent-evidence-catalog.example/attestations/agent-evaluation/v1" },
                "predicate": { "$ref": "evidence-receipt-predicate-v1.schema.json" }
              }
            }
          ]
        }
      }
    }
  }
}
